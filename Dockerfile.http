# 使用 Alpine 作为基础镜像
FROM alpine:latest

# 安装必要的依赖（如果需要）
RUN apk add --no-cache ca-certificates

# 将编译好的 Go 二进制文件复制到镜像中
COPY main /main

# 设置工作目录

EXPOSE 8005
# 设置容器启动时运行的命令
CMD ["./main"]