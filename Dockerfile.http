# 使用 Alpine 作为基础镜像
FROM alpine:latest

# 安装必要的依赖（如果需要）
RUN apk add --no-cache ca-certificates

# 设置工作目录
WORKDIR /app

# 将当前目录的 main 文件复制到容器的 /app 目录下
COPY main /app/main

# 暴露容器的 8005 端口
EXPOSE 8005

# 设置容器启动时运行的命令
CMD ["./main"]