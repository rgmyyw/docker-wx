# 构建阶段
FROM golang:1.20 as builder
LABEL maintainer="Jacky123"

WORKDIR /usr/wic-go
COPY . .
RUN go env -w GOPROXY=https://goproxy.cn,direct
RUN go mod download
RUN go build -o main .

# 运行阶段
FROM alpine:latest
WORKDIR /usr/wic-go
COPY --from=builder /usr/wic-go/main .
EXPOSE 8005
ENTRYPOINT ["./main"]